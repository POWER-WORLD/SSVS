# ===============================================
# Student Score View System (SSVS) Environment Variables
# ===============================================

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Database Configuration
# For PostgreSQL (e.g. Neon, Supabase, Local PostgreSQL):
# DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require
# For local SQLite development:
# DATABASE_URL=sqlite:///instance/ssvs_dev.db
DATABASE_URL=

# Server Port (optional, defaults to 5000)
PORT=5000

# Google Apps Script Email Gateway for OTP & Verification Delivery
# Direct Gmail delivery over HTTPS without SMTP port restrictions
GAS_EMAIL_URL=https://script.google.com/macros/s/your_deployment_id_here/exec
GAS_SECRET_TOKEN=your_secure_random_secret_token_here
