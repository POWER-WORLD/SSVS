# ===============================================
# Student Score View System (SSVS) Environment Variables
# ===============================================

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Database Configuration
# For PostgreSQL (e.g. Neon, Supabase, Local PostgreSQL):
# DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require
# For local SQLite development:
# DATABASE_URL=sqlite:///instance/ssvs_dev.db
DATABASE_URL=

# Server Port (optional, defaults to 5000)
PORT=5000
